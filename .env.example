# Қауымдастық порталы: орта айнымалыларының үлгісі.
# Нақты мәндерді `.env` файлына жазыңыз (ол git-ке түспейді). Бұл файлда құпия кілт болмауы тиіс.

# --- Дерекқор (PostgreSQL 16+) ---
# Docker: `docker compose up -d` (хост порты 5433: компьютерде 5432 бос болмауы мүмкін).
# Docker жоқ болса: `npm run db:dev` (embedded Postgres, порт 54329) және DATABASE_URL бос қалдырылады
# (әзірлеу ортасында әдепкі мән postgresql://kfca:kfca@127.0.0.1:54329/kfca).
DATABASE_URL=postgresql://kfca:kfca@127.0.0.1:5433/kfca
POSTGRES_PASSWORD=kfca

# --- Payload ---
# Өндірісте ұзын кездейсоқ мән міндетті, мысалы: openssl rand -hex 32
PAYLOAD_SECRET=

# --- Сайт ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- S3-үйлесімді қойма (MinIO) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=kfca-public
S3_BUCKET_PRIVATE=kfca-private
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- SMTP (жергілікті провайдер) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Қауымдастық <info@example.kz>"

# --- Proof-of-work капча (ALTCHA, Google reCAPTCHA емес) ---
ALTCHA_HMAC_KEY=

# --- 2FA құпияларын шифрлау кілті (32 байт, hex) ---
TWOFA_ENC_KEY=

# --- Әкімші панелінің 2FA қақпасы (ТТ 14.1) ---
# on: TOTP расталмаса, панель мен API жабық. off: өшірулі. Бос болса: өндірісте (NODE_ENV=production) on, әзірлеуде off.
ADMIN_2FA=

# --- Жаңа өтініш туралы хабар алатын қызметкерлердің поштасы (үтірмен бөлінеді) ---
# Хат жіберу үшін SMTP адаптері қажет: `npm i @payloadcms/email-nodemailer` және payload.config.ts-те email қосу.
NOTIFY_EMAILS=

# --- Аналитика (өз серверіндегі Umami) ---
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
